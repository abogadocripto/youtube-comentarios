# Copiar a .env (permisos 600) y completar. Nunca versionar .env. En el VPS, preferible sops/age.

# Base de datos (la contraseña debe coincidir con secrets/pg_password.txt)
BP_DATABASE_URL=postgresql://bp:CAMBIAR@postgres:5432/bp

# LLM
ANTHROPIC_API_KEY=

# Telegram: bot publicador (solo envía al canal) y bot de edición (grupo privado)
TELEGRAM_PUBLISHER_TOKEN=
TELEGRAM_CHANNEL_ID=            # @canal o -100… (canal de PRUEBAS durante el modo sombra)
TELEGRAM_ADMIN_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Claves de fuentes (solo las contratadas; ver config/sources.yaml y docs/02 §5)
COINGECKO_API_KEY=
SOSOVALUE_API_KEY=
COINALYZE_API_KEY=
COINGLASS_API_KEY=
CMC_API_KEY=
CRYPTOQUANT_API_KEY=
BITCOIN_RPC_AUTH=

# Healthchecks.io: URL de ping de cada job (https://hc-ping.com/<uuid>)
HC_DAILY_INGEST=
HC_DAILY_BUILD=
HC_DAILY_PUBLISH=
HC_BACKUP=

# Copias (deploy/backup.sh)
BP_BACKUP_REMOTE=               # remoto de rclone, p. ej. hetzner:blindaje-backups
BP_BACKUP_AGE_RECIPIENT=        # clave pública age del despacho (la privada NO está en el VPS)

# Identificación de las peticiones a las fuentes
BP_USER_AGENT=BlindajePatrimonial/0.1 (+mailto:[●])
